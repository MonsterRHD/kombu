+++        self.predefined_queues = predefined_queues or {}
+++        self.visibility_timeout = visibility_timeout
+++        self.hub = _FakeHub()
+++        self.async_connections = defaultdict(_FakeAsyncSQS)
+++        self.asynsqs_calls = []
