+    def test_credential_or_connection_refresh_continues_same_lease(self):
+        lease, channel = self.lease(max_retries=5)
+        lease.add(_lease_message('h1'), 'h1')
+        self.advance(10)
+        self.fire_due(lease, 'h1')
+        conn = channel.async_connections['queue-a']
