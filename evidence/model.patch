+        for channel in self.channels:
+            try:
+                channel._qos._dirty.clear()
+                channel._qos._delivered.clear()
+            except AttributeError:
+                pass
+        self._remove_temporary_folders()
+        try:
+            shutil.rmtree(self.processed_folder)
+        except OSError:
+            pass
